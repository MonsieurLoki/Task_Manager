# Renseignez vos clés API Supabase ici
# Vous les trouverez dans les paramètres de votre projet Supabase > API

# URL de votre projet Supabase
SUPABASE_URL=https://VOTRE_PROJET.supabase.co

# Clé publique (sûre pour être utilisée dans le navigateur)
SUPABASE_ANON_KEY=VOTRE_CLE_ANON_SUPABASE

# Clé de service (garder secrète, pour le serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE_SUPABASE

# Configuration du serveur
PORT=3000
NODE_ENV=development 